+#[test]
+fn workspace_zoom_offset_and_cancellation_restore_normal_scale() {
+    let mut layout = workspace_zoom_layout(Options::default());
+    layout.switch_workspace_zoom(2, false);
+    Op::AdvanceAnimations { msec_delta: 390 }.apply(&mut layout);
+    let mon = layout.active_monitor().unwrap();
+    let sample = (mon.workspace_render_idx(), mon.overview_zoom());
+    mon.add_workspace_top();
+    assert_eq!(
+        (mon.workspace_render_idx(), mon.overview_zoom()),
+        (sample.0 + 1., sample.1)
+    );
+    mon.workspace_switch_gesture_begin(true);
+    assert_eq!(mon.overview_zoom(), 1.);
+    assert!(!mon.overview_open);
+    layout.verify_invariants();
+}
