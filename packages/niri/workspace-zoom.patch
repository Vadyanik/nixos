+#[test]
+fn workspace_zoom_respects_animation_off_and_actual_overview() {
+    let mut options = Options::default();
+    options.animations.workspace_switch.0.off = true;
+    let mut layout = workspace_zoom_layout(options);
+    layout.switch_workspace_zoom(2, false);
+    assert!(!matches!(
+        layout.active_monitor_ref().unwrap().workspace_switch,
+        Some(super::super::monitor::WorkspaceSwitch::Zoom(_))
+    ));
+    assert_eq!(layout.active_monitor_ref().unwrap().overview_zoom(), 1.);
+
+    let mut layout = workspace_zoom_layout(Options::default());
+    layout.open_overview();
+    layout.switch_workspace_zoom(2, false);
+    assert!(layout.overview_open);
+    assert!(!matches!(
+        layout.active_monitor_ref().unwrap().workspace_switch,
+        Some(super::super::monitor::WorkspaceSwitch::Zoom(_))
+    ));
+}
