+fn workspace_zoom_layout(options: Options) -> Layout<TestWindow> {
+    let mut layout = check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            Op::AddNamedWorkspace {
+                ws_name: 1,
+                output_name: None,
+                layout_config: None,
+            },
+            Op::AddNamedWorkspace {
+                ws_name: 2,
+                output_name: None,
+                layout_config: None,
+            },
+        ],
+    );
+    let mon = layout.active_monitor().unwrap();
+    mon.active_workspace_idx = 0;
+    mon.workspace_switch = None;
+    layout
+}
+
+fn workspace_zoom_sample(layout: &Layout<TestWindow>) -> (f64, f64) {
+    let mon = layout.active_monitor_ref().unwrap();
+    (mon.workspace_render_idx(), mon.overview_zoom())
+}
+
+#[test]
+fn workspace_zoom_staged_trip_keeps_overview_closed() {
+    let mut layout = workspace_zoom_layout(Options::default());
+    layout.switch_workspace_zoom(2, false);
+    assert_eq!(workspace_zoom_sample(&layout), (0., 1.));
+    Op::AdvanceAnimations { msec_delta: 210 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (0., 0.65));
+    Op::AdvanceAnimations { msec_delta: 165 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (1., 0.65));
+    Op::AdvanceAnimations { msec_delta: 165 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (2., 0.65));
+    Op::AdvanceAnimations { msec_delta: 210 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (2., 1.));
+    let mon = layout.active_monitor_ref().unwrap();
+    assert!(!mon.overview_open);
+    assert_eq!(mon.overview_progress_value(), None);
+    assert!(mon.workspace_switch.is_none());
+    layout.verify_invariants();
+}
+
+#[test]
+fn workspace_zoom_same_and_repeated_destinations() {
+    let mut layout = workspace_zoom_layout(Options::default());
+    layout.switch_workspace_zoom(0, false);
+    assert!(layout
+        .active_monitor_ref()
+        .unwrap()
+        .workspace_switch
+        .is_none());
+    layout.switch_workspace_zoom(2, false);
+    Op::AdvanceAnimations { msec_delta: 390 }.apply(&mut layout);
+    let sample = workspace_zoom_sample(&layout);
+    layout.switch_workspace_zoom(2, false);
+    assert_eq!(workspace_zoom_sample(&layout), sample);
+    // The original timeline continues instead of restarting the zoom-out phase.
+    Op::AdvanceAnimations { msec_delta: 390 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (2., 1.));
+}
+
+#[test]
+fn workspace_zoom_retarget_and_normal_interruption_are_continuous() {
+    let mut layout = workspace_zoom_layout(Options::default());
+    layout.switch_workspace_zoom(2, false);
+    Op::AdvanceAnimations { msec_delta: 100 }.apply(&mut layout);
+    let sample = workspace_zoom_sample(&layout);
+    layout.switch_workspace_zoom(1, false);
+    assert_eq!(workspace_zoom_sample(&layout), sample);
+    Op::AdvanceAnimations { msec_delta: 390 }.apply(&mut layout);
+    let sample = workspace_zoom_sample(&layout);
+    layout.switch_workspace(2);
+    assert_eq!(workspace_zoom_sample(&layout), sample);
+    Op::AdvanceAnimations { msec_delta: 150 }.apply(&mut layout);
+    let (index, zoom) = workspace_zoom_sample(&layout);
+    assert!(index > sample.0 && index < 2.);
+    assert!(zoom > sample.1 && zoom < 1.);
+    Op::AdvanceAnimations { msec_delta: 150 }.apply(&mut layout);
+    assert_eq!(workspace_zoom_sample(&layout), (2., 1.));
+    layout.verify_invariants();
+}
