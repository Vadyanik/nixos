+/// A camera transition independent of the interactive overview state.
+#[derive(Debug)]
+pub struct WorkspaceSwitchZoom {
+    progress: Animation,
+    from_idx: f64,
+    to_idx: f64,
+    from_zoom: f64,
+    /// Ordinary workspace actions interrupt the trip and smoothly restore normal scale.
+    settling: bool,
+}
+
+impl WorkspaceSwitchZoom {
+    fn smoothstep(value: f64) -> f64 {
+        let value = value.clamp(0., 1.);
+        value * value * (3. - 2. * value)
+    }
+
+    fn current_idx(&self) -> f64 {
+        let progress = self.progress.value().clamp(0., 1.);
+        let travel = if self.settling {
+            Self::smoothstep(progress)
+        } else {
+            Self::smoothstep((progress - 0.28) / 0.44)
+        };
+        self.from_idx + (self.to_idx - self.from_idx) * travel
+    }
+
+    fn zoom(&self) -> f64 {
+        let progress = self.progress.value().clamp(0., 1.);
+        if self.settling {
+            return self.from_zoom + (1. - self.from_zoom) * Self::smoothstep(progress);
+        }
+        // Keep the camera still while zooming out, travel, then zoom back in.
+        let far_zoom = 0.65;
+        if progress < 0.28 {
+            self.from_zoom + (far_zoom - self.from_zoom) * Self::smoothstep(progress / 0.28)
+        } else if progress < 0.72 {
+            far_zoom
+        } else {
+            far_zoom + (1. - far_zoom) * Self::smoothstep((progress - 0.72) / 0.28)
+        }
+    }
 }
 
