+/// Pointer position in logical pixels, relative to the output it is on.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq)]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub struct PointerPosition {
+    /// Name of the output under the pointer.
+    pub output: String,
+    /// Horizontal position within the output.
+    pub x: f64,
+    /// Vertical position within the output.
+    pub y: f64,
+}
